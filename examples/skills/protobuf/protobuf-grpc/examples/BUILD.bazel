load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "customerv1_proto",
    srcs = ["service.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "customerv1_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/enterprise/service/api/customer/v1",
    proto = ":customerv1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "customer",
    embed = [":customerv1_go_proto"],
    importpath = "github.com/enterprise/service/api/customer/v1",
    visibility = ["//visibility:public"],
)
