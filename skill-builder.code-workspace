			"**/.venv": true,
			"**/__pycache__": true,
			"**/*.egg-info": true,
			"**/.pytest_cache": true,
			"**/node_modules": true,
			"**/.next": true,
			"**/target": true,
			"**/dist": true,
			"**/uv.lock": true,
			"**/go.sum": true
		},
		"files.watcherExclude": {
			"**/bazel-*/**": true,
			"**/.bazel-cache/**": true,
			"**/.gemini/**": true,
			"**/.venv/**": true,
			"**/__pycache__/**": true,
			"**/node_modules/**": true,
			"**/.next/**": true,
			"**/target/**": true,
			"**/dist/**": true
