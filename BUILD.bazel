package(default_visibility = ["//visibility:public"])

filegroup(
    name = "skills_data",
    srcs = glob(["skills/**"], allow_empty = True),
)

filegroup(
    name = "docs_data",
    srcs = glob(["docs/**"], allow_empty = True) + ["mkdocs.yml"],
)

alias(
    name = "validate",
    actual = "//packages/validator:validate_skills",
)

alias(
    name = "test",
    actual = "//packages/validator:test_validator",
)

alias(
    name = "start-agent",
    actual = "//packages/skills-agent:start_agent",
)

alias(
    name = "docs",
    actual = "//packages/skills-loader:docs",
)

alias(
    name = "serve-docs",
    actual = "//packages/skills-loader:docs",
)
