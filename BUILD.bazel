load("@gazelle//:def.bzl", "gazelle")


# gazelle:prefix github.com/retail-cortex/skills
gazelle(name = "gazelle")

package(default_visibility = ["//visibility:public"])


filegroup(
    name = "skills_data",
    srcs = glob(["examples/skills/**", "examples/skills-*/src/*/skills/**"], allow_empty = True) + [
        "//examples/skills-python:skills_python_data",
        "//examples/skills-go:skills_go_data",
        "//examples/skills-java:skills_java_data",
    ],
)

filegroup(
    name = "docs_data",
    srcs = glob(["docs/**"], allow_empty = True) + ["mkdocs.yml"],
)

alias(
    name = "validate",
    actual = "//packages/validator:validate_skills",
)

alias(
    name = "test",
    actual = "//packages/validator:test_validator",
)

alias(
    name = "start-agent",
    actual = "//tests/adk-agent:start_agent",
)

alias(
    name = "docs",
    actual = "//tools/docs:docs",
)

alias(
    name = "serve-docs",
    actual = "//tools/docs:docs",
)

alias(
    name = "go-loader",
    actual = "//clients/go/cmd/skills-loader",
)

alias(
    name = "skm",
    actual = "//apps/cli/cmd/skm",
)

alias(
    name = "skm-binaries",
    actual = "//apps/cli/cmd/skm:skm_binaries",
)

alias(
    name = "diagrams",
    actual = "//tools/proto_diagrams",
)



test_suite(
    name = "test-e2e",
    tests = [
        "//tests/e2e:test_skills_e2e",
        "//clients/go/pkg/skillsloader:skillsloader_test",
        "//clients/java:skills_loader_java_test",
        "//apps/cli/internal/validator:validator_test",
        "//apps/cli/internal/installer:installer_test",
        "//apps/cli/internal/commands:commands_test",
    ],
)



