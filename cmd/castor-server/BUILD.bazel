load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "castor-server_lib",
    srcs = [
        "config.go",
        "handlers.go",
        "main.go",
    ],
    importpath = "github.com/retail-cortex/skills/cmd/castor-server",
    deps = [
        "//pkg/data",
        "//pkg/embedding",
        "//pkg/embedding/alloydb",
        "//pkg/embedding/vertex",
        "//pkg/mcp",
        "//pkg/model",
        "//pkg/service",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_mark3labs_mcp_go//server",
        "@com_github_rrmcguinness_modenv//pkg/modenv",
    ],
)

go_binary(
    name = "castor-server",
    data = [".env.toml"],
    embed = [":castor-server_lib"],
)

go_test(
    name = "castor-server_test",
    size = "small",
    srcs = ["service_test.go"],
    data = [".env.toml"],
    embed = [":castor-server_lib"],
    deps = [
        "//pkg/data",
        "//pkg/model",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Backwards compatibility and alternative aliases
alias(
    name = "castor-service",
    actual = ":castor-server",
)

alias(
    name = "skills-service",
    actual = ":castor-server",
)

alias(
    name = "skills-service_lib",
    actual = ":castor-server_lib",
)

alias(
    name = "skills-service_test",
    actual = ":castor-server_test",
)
