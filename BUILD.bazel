load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/retail-cortex/skills
gazelle(name = "gazelle")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "skills_data",
    srcs = glob(
        [
            "examples/skills/**",
            "examples/*/skills/src/*/skills/**",
        ],
        allow_empty = True,
    ) + [
        "//examples/go/skills:skills_go_data",
        "//examples/java/skills:skills_java_data",
        "//examples/python/skills:skills_python_data",
    ],
)

alias(
    name = "start-agent",
    actual = "//tests/adk-agent:start_agent",
)

alias(
    name = "go-loader",
    actual = "//clients/go/cmd/skills-loader",
)

alias(
    name = "python-loader",
    actual = "//clients/python:loader_lib",
)

alias(
    name = "java-loader",
    actual = "//clients/java:skills_loader_java",
)

alias(
    name = "skm",
    actual = "//cmd/skm",
)

alias(
    name = "skm-binaries",
    actual = "//cmd/skm:skm_binaries",
)

alias(
    name = "skills-service",
    actual = "//cmd/skills-service",
)

alias(
    name = "docs",
    actual = "//docs:serve",
)

alias(
    name = "serve-docs",
    actual = "//docs:serve",
)

alias(
    name = "site",
    actual = "//docs:site",
)

alias(
    name = "validate",
    actual = "//cmd/skm",
)

alias(
    name = "diagrams",
    actual = "//tools/proto_diagrams",
)

test_suite(
    name = "test-e2e",
    tests = [
        "//clients/go/pkg/skillsloader:skillsloader_test",
        "//clients/java:skills_loader_java_test",
        "//cmd/skills-service:skills-service_test",
        "//examples/go/client:test_go_client_example",
        "//examples/java/client:test_java_client_example",
        "//examples/python/client:test_python_client_example",
        "//examples/python/polyglot:test_polyglot_developer",
        "//internal/commands:commands_test",
        "//internal/installer:installer_test",
        "//pkg/validator:validator_test",
        "//tests/e2e:test_skills_e2e",
    ],
)
