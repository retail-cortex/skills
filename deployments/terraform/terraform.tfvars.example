# Example Terraform Variables for Skill Builder GCP Infrastructure

project_id        = "your-gcp-project-id"
region            = "us-central1"
network_name      = "skill-builder-vpc"
alloydb_cpu_count = 2

environments = ["dev", "qa", "prod"]

gke_node_configs = {
  dev = {
    min_nodes    = 1
    max_nodes    = 3
    machine_type = "e2-standard-4"
    disk_size_gb = 50
    preemptible  = true
  }
  qa = {
    min_nodes    = 1
    max_nodes    = 4
    machine_type = "e2-standard-4"
    disk_size_gb = 50
    preemptible  = false
  }
  prod = {
    min_nodes    = 3
    max_nodes    = 10
    machine_type = "n2-standard-4"
    disk_size_gb = 100
    preemptible  = false
  }
}
