package(default_visibility = ["//visibility:public"])

filegroup(
    name = "examples_files",
    srcs = glob(["**"]),
)

# gazelle:prefix github.com/enterprise/service
gazelle(name = "gazelle")

go_library(
    name = "server_lib",
    srcs = ["cmd/server/main.go"],
    importpath = "github.com/enterprise/service/cmd/server",
    deps = [
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_rrmcguinness_modenv//pkg/modenv",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
)
