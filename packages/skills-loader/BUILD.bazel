load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "skills_loader_lib",
    srcs = glob(["src/skills_loader/**/*.py"]),
    data = ["//:skills_data"],
    imports = ["src"],
)

py_test(
    name = "test_loader",
    srcs = ["tests/test_loader.py"],
    data = ["//:skills_data"],
    main = "tests/test_loader.py",
    deps = [":skills_loader_lib"],
)
