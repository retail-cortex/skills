load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "loader_lib",
    srcs = glob(["src/loader/**/*.py"]),
    data = ["//:skills_data"],
    imports = ["src"],
    deps = [
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "test_loader",
    size = "small",
    srcs = ["tests/test_loader.py"],
    data = ["//:skills_data"],
    main = "tests/test_loader.py",
    tags = ["no-ci"],
    deps = [":loader_lib"],
)

py_test(
    name = "test_discovery_compiler_hitl",
    size = "small",
    srcs = ["tests/test_discovery_compiler_hitl.py"],
    data = ["//:skills_data"],
    main = "tests/test_discovery_compiler_hitl.py",
    deps = [":loader_lib"],
)

py_test(
    name = "test_build_meta",
    size = "small",
    srcs = ["tests/test_build_meta.py"],
    main = "tests/test_build_meta.py",
    deps = [":loader_lib"],
)
