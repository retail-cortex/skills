load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "data_lib",
    srcs = glob(["src/data/**/*.py"]),
    imports = ["src"],
    deps = [
        "//packages/loader:loader_lib",
        "//packages/model:model_lib",
        "@pypi//asyncpg:pkg",
        "@pypi//fastapi:pkg",
        "@pypi//psycopg2_binary:pkg",
        "@pypi//pydantic:pkg",
        "@pypi//sqlmodel:pkg",
    ],
)

py_test(
    name = "test_data",
    size = "small",
    srcs = ["tests/test_data.py"],
    main = "tests/test_data.py",
    deps = [
        ":data_lib",
        "@pypi//pytest:pkg",
    ],
)
