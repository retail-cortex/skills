load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "mcp_lib",
    srcs = glob(["src/skills_mcp/**/*.py"]),
    imports = ["src"],
    deps = [
        "//packages/data:data_lib",
        "//packages/services:services_lib",
        "//packages/model:model_lib",
        "@pypi//anyio:pkg",
        "@pypi//cachetools:pkg",
        "@pypi//cyclopts:pkg",
        "@pypi//docstring_parser:pkg",
        "@pypi//fastmcp:pkg",
        "@pypi//griffelib:pkg",
        "@pypi//joserfc:pkg",
        "@pypi//jsonref:pkg",
        "@pypi//jsonschema:pkg",
        "@pypi//jsonschema_path:pkg",
        "@pypi//jsonschema_specifications:pkg",
        "@pypi//markdown_it_py:pkg",
        "@pypi//mcp:pkg",
        "@pypi//mdurl:pkg",
        "@pypi//py_key_value_aio:pkg",
        "@pypi//pygments:pkg",
        "@pypi//referencing:pkg",
        "@pypi//rich:pkg",
        "@pypi//rpds_py:pkg",
        "@pypi//sqlmodel:pkg",
        "@pypi//uncalled_for:pkg",
    ],
)

py_test(
    name = "test_mcp",
    size = "small",
    srcs = ["tests/test_mcp.py"],
    main = "tests/test_mcp.py",
    deps = [
        ":mcp_lib",
        "@pypi//pytest:pkg",
    ],
)
