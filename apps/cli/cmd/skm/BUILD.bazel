load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "skm_lib",
    srcs = ["main.go"],
    importpath = "github.com/retail-cortex/skills/apps/cli/cmd/skm",
    deps = [
        "//apps/cli/internal/commands",
    ],
)

# Native host binary
go_binary(
    name = "skm",
    embed = [":skm_lib"],
)

# Cross-platform native Bazel targets using go_cross_binary
# This ensures tools (protoc, abseil) run in the exec configuration without triggering target C++/Xcode toolchain evaluation.
go_cross_binary(
    name = "skm_linux_amd64",
    platform = "@rules_go//go/toolchain:linux_amd64",
    target = ":skm",
)

go_cross_binary(
    name = "skm_linux_arm64",
    platform = "@rules_go//go/toolchain:linux_arm64",
    target = ":skm",
)

go_cross_binary(
    name = "skm_darwin_amd64",
    platform = "@rules_go//go/toolchain:darwin_amd64",
    target = ":skm",
)

go_cross_binary(
    name = "skm_darwin_arm64",
    platform = "@rules_go//go/toolchain:darwin_arm64",
    target = ":skm",
)

go_cross_binary(
    name = "skm_windows_amd64",
    platform = "@rules_go//go/toolchain:windows_amd64",
    target = ":skm",
)

filegroup(
    name = "skm_binaries",
    srcs = [
        ":skm_darwin_amd64",
        ":skm_darwin_arm64",
        ":skm_linux_amd64",
        ":skm_linux_arm64",
        ":skm_windows_amd64",
    ],
)
