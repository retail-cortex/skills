load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "validator_lib",
    srcs = glob(["src/validator/**/*.py"]),
    imports = ["src"],
)

py_binary(
    name = "validate_skills",
    srcs = ["src/validator/cli.py"],
    main = "src/validator/cli.py",
    deps = [":validator_lib"],
)

py_test(
    name = "test_validator",
    srcs = ["tests/test_validator.py"],
    data = ["//:skills_data"],
    main = "tests/test_validator.py",
    deps = [
        ":validator_lib",
        "//packages/loader:loader_lib",
    ],
)
