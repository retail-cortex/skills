load("@rules_go//go:def.bzl", "go_binary", "go_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "skm_lib",
    srcs = ["main.go"],
    importpath = "github.com/retail-cortex/skills/cli/cmd/skm",
    deps = [
        "//cli/internal/commands",
    ],
)

# Native host binary
go_binary(
    name = "skm",
    embed = [":skm_lib"],
)

# Cross-platform native Bazel targets
go_binary(
    name = "skm_linux_amd64",
    embed = [":skm_lib"],
    goarch = "amd64",
    goos = "linux",
)

go_binary(
    name = "skm_linux_arm64",
    embed = [":skm_lib"],
    goarch = "arm64",
    goos = "linux",
)

go_binary(
    name = "skm_darwin_amd64",
    embed = [":skm_lib"],
    goarch = "amd64",
    goos = "darwin",
)

go_binary(
    name = "skm_darwin_arm64",
    embed = [":skm_lib"],
    goarch = "arm64",
    goos = "darwin",
)

go_binary(
    name = "skm_windows_amd64",
    embed = [":skm_lib"],
    goarch = "amd64",
    goos = "windows",
)

filegroup(
    name = "skm_binaries",
    srcs = [
        ":skm_darwin_amd64",
        ":skm_darwin_arm64",
        ":skm_linux_amd64",
        ":skm_linux_arm64",
        ":skm_windows_amd64",
    ],
)
