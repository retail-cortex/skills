# GitHub API Token for authenticating against private repos and increasing rate limits
GITHUB_TOKEN=ghp_example_token_123456789

# Qualified skill roots (file:// for local paths and github://owner/repo/subpath:branch for remote repos)
SKILLS_ROOTS=file://skills,github://google/skills/skills/cloud/gemini-api:main

# Selective skill loading (comma-separated list of skill names). If set, only these specific skills will be loaded.
SKILLS_FILTER=a2a,bigquery,python-core,gemini-api
