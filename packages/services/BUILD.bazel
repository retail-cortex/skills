load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "services_lib",
    srcs = glob(["src/services/**/*.py"]),
    imports = ["src"],
    deps = [
        "//api/v1:skills_v1_py_grpc",
        "//packages/data:data_lib",
        "//packages/loader:loader_lib",
        "//packages/model:model_lib",
        "@pypi//fastapi:pkg",
        "@pypi//google_auth:pkg",
        "@pypi//google_genai:pkg",
        "@pypi//grpcio:pkg",
        "@pypi//opentelemetry_api:pkg",
        "@pypi//opentelemetry_exporter_gcp_trace:pkg",
        "@pypi//opentelemetry_sdk:pkg",
        "@pypi//pydantic:pkg",
        "@pypi//sqlmodel:pkg",
    ],
)

py_test(
    name = "test_services",
    size = "small",
    srcs = ["tests/test_services.py"],
    main = "tests/test_services.py",
    deps = [
        ":services_lib",
        "@pypi//pytest:pkg",
        "@pypi//pytest_asyncio:pkg",
    ],
)
