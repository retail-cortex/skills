load("@rules_go//go:def.bzl", "go_library", "go_test")



package(default_visibility = ["//visibility:public"])

go_library(
    name = "skillsloader",
    srcs = [
        "loader.go",
        "types.go",
    ],
    importpath = "github.com/retail-cortex/skills/clients/go/pkg/skillsloader",
    deps = [
        "//api/v1:skills_v1_go_proto",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_test(
    name = "skillsloader_test",
    size = "small",
    srcs = [
        "loader_test.go",
        "types_test.go",
    ],
    data = ["//:skills_data"],
    embed = [":skillsloader"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
