load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/retail-cortex/castor
gazelle(name = "gazelle")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "skills_data",
    srcs = glob(
        [
            "examples/skills/**",
            "examples/*/skills/src/*/skills/**",
        ],
        allow_empty = True,
    ) + [
        "//examples/go/skills:skills_go_data",
        "//examples/java/skills:skills_java_data",
        "//examples/python/skills:skills_python_data",
    ],
)

alias(
    name = "start-agent",
    actual = "//tests/adk-agent:start_agent",
)

alias(
    name = "go-client",
    actual = "//clients/go:castor-client",
)

alias(
    name = "castor-client-go",
    actual = "//clients/go:castor-client",
)

alias(
    name = "go-loader",
    actual = "//clients/go:castor-client",
)

alias(
    name = "python-client",
    actual = "//clients/python:castor_client",
)

alias(
    name = "castor-client-python",
    actual = "//clients/python:castor_client",
)

alias(
    name = "python-loader",
    actual = "//clients/python:castor_client",
)

alias(
    name = "java-client",
    actual = "//clients/java:castor_client_java",
)

alias(
    name = "castor-client-java",
    actual = "//clients/java:castor_client_java",
)

alias(
    name = "java-loader",
    actual = "//clients/java:castor_client_java",
)

alias(
    name = "cstr",
    actual = "//cmd/cstr",
)

alias(
    name = "cstr-binaries",
    actual = "//cmd/cstr:cstr_binaries",
)

alias(
    name = "castor-server",
    actual = "//cmd/castor_server",
)

alias(
    name = "castor-service",
    actual = "//cmd/castor_server",
)

alias(
    name = "castor-registry",
    actual = "//cmd/castor_server",
)

alias(
    name = "skm",
    actual = "//cmd/cstr",
)

alias(
    name = "skm-binaries",
    actual = "//cmd/cstr:cstr_binaries",
)

alias(
    name = "skills-service",
    actual = "//cmd/castor_server",
)

alias(
    name = "docs",
    actual = "//docs:serve",
)

alias(
    name = "serve-docs",
    actual = "//docs:serve",
)

alias(
    name = "site",
    actual = "//docs:site",
)

alias(
    name = "validate",
    actual = "//cmd/cstr",
)

alias(
    name = "diagrams",
    actual = "//tools/proto_diagrams",
)

test_suite(
    name = "test-e2e",
    tests = [
        "//clients/go/pkg/castor_client:castor_client_test",
        "//clients/java:castor_client_java_test",
        "//clients/python:test_castor_client",
        "//cmd/castor_server:castor-server_test",
        "//examples/go/client:test_go_client_example",
        "//examples/java/client:test_java_client_example",
        "//examples/python/client:test_python_client_example",
        "//examples/python/polyglot:test_polyglot_developer",
        "//internal/commands:commands_test",
        "//internal/installer:installer_test",
        "//pkg/validator:validator_test",
        "//tests/e2e:test_skills_e2e",
    ],
)
