load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@protobuf//bazel:java_proto_library.bzl", "java_proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")





package(default_visibility = ["//visibility:public"])

proto_library(
    name = "skills_v1_proto",
    srcs = [
        "manifest.proto",
        "skill.proto",
    ],
)

go_proto_library(
    name = "skills_v1_go_proto",
    importpath = "github.com/retail-cortex/skills/api/v1",
    proto = ":skills_v1_proto",
)

java_proto_library(
    name = "skills_v1_java_proto",
    deps = [":skills_v1_proto"],
)

py_proto_library(
    name = "skills_v1_py_proto",
    deps = [":skills_v1_proto"],
)
