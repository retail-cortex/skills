load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "commands",
    srcs = [
        "commands.go",
        "config.go",
        "login.go",
        "register.go",
    ],
    importpath = "github.com/retail-cortex/skills/internal/commands",
    deps = [
        "//clients/go/pkg/skillsloader",
